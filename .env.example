# Public Stats NZ AES source used by this project. No secrets are required.
AES_SOURCE_FILE=data/raw/annual-enterprise-survey-2025-financial-year-provisional.csv
AES_SOURCE_URL=https://www.stats.govt.nz/assets/Uploads/Annual-enterprise-survey/Annual-enterprise-survey-2025-financial-year-provisional/Download-data/annual-enterprise-survey-2025-financial-year-provisional.csv
AES_DATASET_YEAR=2025
AES_DATASET_VERSION=2025-financial-year-provisional
AES_SOURCE_SHA256=C029D234EEFD3FEE2563B9C0929946CA336509AB62A02BD111C80F978298C66C
AES_SCHEMA_VERSION=aes-public-csv-v1
AES_INGESTION_MANIFEST=data/ingestion/manifest.json

# Phase 4 Bronze Delta settings.
BRONZE_TABLE_PATH=data/bronze/aes
SILVER_TABLE_PATH=data/silver/aes_observations
QUALITY_REPORT_PATH=data/quality/silver-quality-report.json
GOLD_METRICS_PATH=data/gold/industry_financial_metrics
REVISION_REPORT_DIR=data/revisions
SPARK_MASTER=local[2]
SPARK_LOG_LEVEL=WARN

# Read-only API: local-development defaults.
NZIB_ANALYTICS_BACKEND=local-spark
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Databricks SQL backend. Leave credentials blank for local-spark development.
# Cloud deployment must supply hostname, HTTP path, and token externally.
# Store DATABRICKS_TOKEN in the cloud secret store; never commit a real value.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=nz_industry_benchmarking
DATABRICKS_GOLD_TABLE=gold_industry_financial_metrics

# Static frontend build setting. Cloud builds must replace this with the public
# FastAPI URL; the browser never receives Databricks connection settings.
FRONTEND_API_BASE_URL=http://127.0.0.1:8000

# Cloud API deployments should override at least:
# NZIB_ANALYTICS_BACKEND=databricks-sql
# API_HOST=0.0.0.0
# API_PORT=<platform-port>
# API_CORS_ORIGINS=https://<frontend-origin>
# Optional offline JVM dependency cache; normally Delta resolves this automatically.
# DELTA_SPARK_LOCAL_JARS=C:/path/to/ivy/jars
